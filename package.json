{
  "name": "commitcade",
  "version": "0.1.0",
  "description": "Turn your GitHub contributions into close encounters. Animated SVG graphs, a CLI, and a GitHub Action.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "main": "./src/core/index.js",
  "exports": { ".": "./src/core/index.js" },
  "bin": { "commitcade": "cli/index.js" },
  "files": ["src/core", "cli", "README.md", "LICENSE"],
  "repository": { "type": "git", "url": "https://github.com/dianbrown/commitcade.git" },
  "keywords": ["github", "contributions", "svg", "ufo", "readme", "github-action"],
  "scripts": {
    "test": "node --test",
    "check": "npm test",
    "demo": "node cli/index.js --demo --output assets/demo.svg"
  }
}
